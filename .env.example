# Copy this file to .env.local and fill in real values.
# Never commit .env.local - it is git-ignored on purpose.

# --- Supabase (Postgres + pgvector) ---
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key is SERVER-ONLY. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Anon key is reserved for a future browser/Supabase-Auth client. Not required for V1 demo auth.
SUPABASE_ANON_KEY=replace-with-anon-key

# --- Demo session signing ---
# Any long random string. Used to HMAC-sign the demo "sign in as" cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# --- LLM / retrieval adapter selection ---
# V1 ships only "demo": a deterministic, offline, rule-based adapter.
# The interface in lib/llm/adapter.ts is provider-agnostic so a real
# model provider can be dropped in later without touching call sites.
LLM_PROVIDER=demo

# --- Optional n8n orchestration webhooks ---
# If unset, the app skips these calls (best-effort, never blocks the request).
N8N_TICKET_TRIAGED_WEBHOOK_URL=
N8N_ABSTENTION_WEBHOOK_URL=
