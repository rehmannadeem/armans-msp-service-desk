# Armans.AI MSP Service Desk Intelligence Layer - LIVE V1
# Never commit real secrets. Copy to .env.local for local use.

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the publishable/anon key here. Browser never receives it directly; server routes use it.
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key

# OpenAI API
OPENAI_API_KEY=replace-with-project-api-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG safety threshold. Tune only after evaluating retrieval.
RAG_MIN_SIMILARITY=0.35

# Optional n8n orchestration webhooks. Core ticket flow does not depend on them.
N8N_TICKET_TRIAGED_WEBHOOK_URL=
N8N_ABSTENTION_WEBHOOK_URL=